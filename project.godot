; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="碧海英豪"
config/description="2D 单机航海 RPG：航行、自动炮战、贸易、舰船养成与母港建设"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
config/version="1.4.8"
[autoload]

EventBus="*res://scripts/core/event_bus.gd"
RngService="*res://scripts/core/rng_service.gd"
DataRegistry="*res://scripts/core/data_registry.gd"
GameState="*res://scripts/core/game_state.gd"
TimeService="*res://scripts/core/time_service.gd"
WorldTick="*res://scripts/systems/world_tick.gd"
SaveManager="*res://scripts/core/save_manager.gd"
SceneRouter="*res://scripts/core/scene_router.gd"
McpInteractionServer="*res://autoload/mcp_interaction_server.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

sail_forward={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":87,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
sail_back={
